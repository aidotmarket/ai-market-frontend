NEXT_PUBLIC_API_URL=https://api.ai.market
API_URL=https://api.ai.market
NEXT_PUBLIC_ENABLE_DATASET_JSONLD=true

# Required in production when Keystatic uses GitHub storage.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# AIM Data website confirmation is on by default; set false as the rollback lever.
# Build-time variable: a redeploy is required for changes to take effect.
NEXT_PUBLIC_AIM_DATA_OAUTH_ENABLED=true
