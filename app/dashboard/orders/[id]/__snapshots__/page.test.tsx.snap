exports[`OrderDetailPage viewer relationship gating > keeps the legacy fulfilled order markup byte-identical to the base 1`] = `"<div><a class="text-sm text-[#3F51B5] hover:underline mb-4 inline-block" href="/dashboard/orders">← Back to Purchases</a><div class="grid grid-cols-1 lg:grid-cols-3 gap-6"><div class="lg:col-span-2 space-y-6"><div class="rounded-lg border border-gray-200 p-6"><div class="flex items-center justify-between mb-4"><h1 class="text-xl font-bold text-gray-900">Order #order-1</h1><span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-medium bg-green-100 text-green-800">Fulfilled</span></div><dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm"><div><dt class="text-gray-500">Listing</dt><dd class="font-medium text-gray-900">Order dataset</dd></div><div><dt class="text-gray-500">Seller</dt><dd class="font-medium text-gray-900">Example Seller</dd></div><div><dt class="text-gray-500">Amount Paid</dt><dd class="font-medium text-gray-900">$25.00</dd></div><div><dt class="text-gray-500">Purchase Date</dt><dd class="font-medium text-gray-900">Aug 21, 2026</dd></div></dl><div class="mt-4"></div></div><div class="rounded-lg border border-gray-200 p-6"><div class="flex items-center justify-between mb-4"><h2 class="text-lg font-semibold text-gray-900">Transaction</h2><span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-medium bg-indigo-100 text-indigo-800">Delivered</span></div><dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm"><div><dt class="text-gray-500">Transaction #</dt><dd class="font-mono font-medium text-gray-900">TX-001</dd></div><div><dt class="text-gray-500">Amount</dt><dd class="font-medium text-gray-900">$25.00</dd></div><div><dt class="text-gray-500">Platform Fee</dt><dd class="font-medium text-gray-900">$2.50</dd></div><div><dt class="text-gray-500">Seller Receives</dt><dd class="font-medium text-gray-900">$22.50</dd></div><div><dt class="text-gray-500">Paid At</dt><dd class="font-medium text-gray-900">Aug 21, 2026</dd></div><div><dt class="text-gray-500">Delivered At</dt><dd class="font-medium text-gray-900">Aug 21, 2026</dd></div></dl><div class="mt-4 flex flex-col sm:flex-row gap-3"><button class="rounded-lg bg-green-600 px-6 py-2.5 text-sm font-medium text-white hover:bg-green-700 disabled:opacity-50 disabled:cursor-not-allowed">Confirm Receipt</button></div></div><div class="rounded-lg border border-gray-200 p-6"><div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="text-lg font-semibold text-gray-900">Downloads</h2></div><button class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50">Refresh Links</button></div><div class="rounded-lg bg-gray-50 px-4 py-3 text-sm text-gray-600">No S3 files are available yet. The seller may still be completing fulfillment.</div></div></div><div class="space-y-4"><div class="rounded-lg border border-gray-200 p-6"><h3 class="font-semibold text-gray-900 mb-3">Actions</h3><a href="mailto:support@ai.market?subject=Issue with Order order-1" class="block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm font-medium text-gray-700 text-center hover:bg-gray-50">Report Issue</a></div></div></div></div>"`;
